# .env.local로 복사해서 씁니다. 모두 선택 항목이며, 비워 두면 공개 시세만 사용합니다.

# ── BINANCE (/binance) ──────────────────────────────
# 이 앱이 쓰는 공개 시장 데이터에는 키가 필요 없습니다.
BINANCE_API_KEY=
BINANCE_FUTURES_REST_URL=https://fapi.binance.com
BINANCE_FUTURES_REST_FALLBACK_URLS=

# ── UPBIT (/upbit) ──────────────────────────────────
# 아래 두 값을 채우면 BALANCE 탭(/api/upbit/accounts)이 켜집니다.
# 업비트 Open API 키는 발급할 때 등록한 "허용 IP"에서만 동작합니다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_REST_URL=https://api.upbit.com
UPBIT_REST_FALLBACK_URLS=
